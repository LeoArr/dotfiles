# ~/.config/git/config — tracked defaults for every machine.
# Identity and machine-specific settings live in ~/.gitconfig.local
# (install.sh migrates a pre-existing ~/.gitconfig there).

[core]
	editor = nvim
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[merge]
	# diff3 (not zdiff3) so merges also work on older server git versions
	conflictStyle = diff3
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[alias]
	st = status -sb
	lg = log --graph --oneline --decorate -20
	last = log -1 --stat
[include]
	path = ~/.gitconfig.local
