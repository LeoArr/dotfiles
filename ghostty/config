# Theme
theme = Catppuccin Macchiato
font-family = Cousine

cursor-invert-fg-bg=true
cursor-opacity=0.8
cursor-style=bar

background-opacity=0.96

# Shift+Enter sends ESC+CR (read as Alt+Enter), which Claude Code and other
# CLI apps treat as "insert newline". Works both inside and outside tmux.
keybind = shift+enter=text:\x1b\r

window-decoration=none
window-padding-x=2
window-padding-y=2
window-padding-balance=true
quit-after-last-window-closed=true

