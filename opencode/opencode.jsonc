{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "whereis *": "allow",
      "type *": "allow",
      "git status": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "git stash list": "allow",
      "git rev-parse *": "allow",
      "npm ls *": "allow",
      "npm list *": "allow",
      "npm info *": "allow",
      "npm view *": "allow",
      "npm outdated": "allow",
      "npm install *": "allow",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm start *": "allow",
      "npm publish *": "allow",
      "yarn list *": "allow",
      "yarn info *": "allow",
      "yarn install *": "allow",
      "yarn add *": "allow",
      "yarn test *": "allow",
      "pnpm list *": "allow",
      "pnpm info *": "allow",
      "pnpm install *": "allow",
      "pnpm add *": "allow",
      "pnpm test *": "allow",
      "pip list": "allow",
      "pip show *": "allow",
      "pip install *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "cargo build *": "allow",
      "cargo check *": "allow",
      "cargo test *": "allow",
      "cargo clippy *": "allow",
      "cargo fmt *": "allow",
      "cargo run *": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker volume ls": "allow",
      "docker-compose *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "xargs *": "allow",
      "tee *": "allow",
      "env": "allow",
      "printenv": "allow",
      "date": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "tar *": "allow",
      "zip *": "allow",
      "unzip *": "allow",
      "ssh *": "allow",
      "scp *": "allow",
      "rsync *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push *": "allow",
      "git pull *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git merge *": "allow",
      "git rebase *": "allow",
      "git tag *": "allow",
      "rm -rf *": "deny",
      "rm -r /": "deny",
      "rmdir /": "deny",
      "sudo *": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "halt": "deny",
      "init *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "kill -9 *": "deny",
      "killall *": "deny",
      "pkill *": "deny",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "wget * | bash": "deny",
      "wget * | sh": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chown -R *": "deny",
      "npm uninstall -g *": "deny",
      "pip uninstall *": "deny",
      "cargo uninstall *": "deny",
      "rm *": "ask"
    },
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow"
  },
  "provider": {
    "local-llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local ik_llama.cpp (Qwen3-Coder-30B-A3B)",
      "options": {
        "baseURL": "http://127.0.0.1:8811/v1",
        "apiKey": "not-needed"
      },
      // Note: only one of these is actually usable at a time - whichever gguf the
      // server was started with (run-server.sh = Q4_K_M, run-server-q3.sh = Q3_K_M).
      // The label just needs to match whichever script is currently running.
      "models": {
        "qwen3-coder-30b-a3b-q4": {
          "name": "Qwen3-Coder-30B-A3B-Instruct (Q4_K_M, local - run-server.sh)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-coder-30b-a3b-q3": {
          "name": "Qwen3-Coder-30B-A3B-Instruct (Q3_K_M, local - run-server-q3.sh)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}